#!/usr/bin/env ruby
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "zohomail_client"
require "dotenv"
require "optparse"

Dotenv.load
ZohomailClient.configure do |config|
  config.client_id = ENV["ZOHOMAIL_CLIENT_ID"]
  config.client_secret = ENV["ZOHOMAIL_CLIENT_SECRET"]
  config.refresh_token = ENV["ZOHOMAIL_REFRESH_TOKEN"]
  config.account_id = ENV["ZOHOMAIL_ACCOUNT_ID"]
  config.cache_file_path = ENV["ZOHOMAIL_CACHE_FILE_PATH"]
end

options = {
  format: "plaintext"
}

opt_parser = OptionParser.new do |opts|
  opts.banner = "Usage: zohomail-reply [options] <message_id>"

  opts.on("-c", "--content CONTENT", "Reply content (interprets \\n as newline, must escape $ as \\$)") { |v| options[:content] = v }
  opts.on("--content-file PATH", "Path to a file containing the reply content") { |v| options[:content_file] = v }
  opts.on("--cc EMAIL", "CC recipient email address (comma separated for multiple)") { |v| options[:cc] = v }
  opts.on("--folder-name NAME", "Folder name of the original message") { |v| options[:folder_name] = v }
  opts.on("--to EMAIL", "Recipient email address (optional, defaults to original sender)") { |v| options[:to] = v }
  opts.on("--format FORMAT", ["html", "plaintext"], "Email format (html or plaintext, default: plaintext)") { |v| options[:format] = v }
  opts.on("--draft", "Save as draft") { options[:is_draft] = true }

  opts.on("-h", "--help", "Show this help") do
    puts opts
    exit
  end
end

opt_parser.parse!

message_id = ARGV.shift
folder_name = options[:folder_name]

if message_id.nil? || (options[:content].nil? && options[:content_file].nil?) || folder_name.nil?
  $stderr.puts "Error: message_id, content (or content-file), and folder_name are required."
  puts opt_parser
  exit 1
end

if options[:content_file]
  if File.exist?(options[:content_file])
    options[:content] = File.read(options[:content_file])
  else
    $stderr.puts "Error: Content file not found at #{options[:content_file]}"
    exit 1
  end
elsif options[:content]
  # Interpret literal \n as actual newlines if present in content
  options[:content] = options[:content].gsub("\\n", "\n")
end

begin
  client = ZohomailClient.client

  puts "Replying to message #{message_id} in folder #{folder_name}..."
  response = client.send_reply(
    folder_name: folder_name,
    message_id: message_id,
    content: options[:content],
    cc: options[:cc],
    mail_format: options[:format],
    is_draft: options[:is_draft],
    to: options[:to]
  )

  if response.dig("status", "description") == "success"
    if options[:is_draft]
      puts "Reply draft created successfully!"
    else
      puts "Reply sent successfully!"
    end
    puts "Message ID: #{response.dig("data", "messageId")}"
  else
    $stderr.puts "Error sending reply: #{response}"
    exit 1
  end
rescue ZohomailClient::Error => e
  $stderr.puts "Error: #{e.message}"
  exit 1
end
